# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env_local' (para desarrollo) o '.env_production' (para prod).
# 2. Rellena los valores vacíos con tus credenciales reales.
# 3. NO subas los archivos con credenciales reales al repositorio.
# =============================================================================

# ==========================================
# 1. CONFIGURACIÓN GENERAL
# ==========================================
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Dominios permitidos para conectar al backend (CORS)
# LOCAL: http://localhost:4200,http://localhost:8080
# PROD:  https://tu-dominio-real.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ==========================================
# 2. BASE DE DATOS
# ==========================================

# OPCIÓN A: Docker Local (Si usas el servicio 'db' en docker-compose)
# URL: jdbc:postgresql://db:5432/postgres
# USER: postgres
# PASS: postgres

# OPCIÓN B: Nube / Producción (NeonDB, AWS RDS, etc.)
# URL: jdbc:postgresql://ep-tu-endpoint.aws.neon.tech/neondb?sslmode=require
# USER: tu_usuario_nube
# PASS: tu_password_nube

DB_URL=
DB_USER=
DB_PASS=

# ==========================================
# 3. AUTH0 - GENERAL (Configuración del Tenant)
# ==========================================
# Dominio de tu cuenta Auth0 (ej: dev-xyz.us.auth0.com)
AUTH0_DOMAIN=

# Identificador de tu API en Auth0 (Audience)
AUTH0_AUDIENCE=https://reservas-api/

# Namespace personalizado usado en las Reglas/Actions para los roles
AUTH0_CLAIMS_NAMESPACE=https://reservas-api/roles

# ==========================================
# 4. AUTH0 - MANAGEMENT API (Backend - Privado)
# ==========================================
# Credenciales de la Aplicación "Machine to Machine" (Backend)
# Necesarias para que el backend pueda leer/editar usuarios y roles.
AUTH0_MGT_CLIENT_ID=
AUTH0_MGT_CLIENT_SECRET=

# IDs de los Roles creados en Auth0 (Se obtienen desde el dashboard de Auth0 -> Roles)
AUTH0_ROLE_ADMIN_ID=
AUTH0_ROLE_CLIENT_ID=

# ==========================================
# 5. AUTH0 - FRONTEND (SPA - Público)
# ==========================================
# Client ID de la Aplicación "Single Page Application" (Angular)
SPA_CLIENT_ID=